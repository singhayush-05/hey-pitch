<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HeyPitch. Pick a style. Get the video.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
/* =========================================================
   HEYPITCH STORE  v0.1
   Everything commercial lives in HP_CONFIG at the bottom.
   Change prices, styles, caps and copy there, not in the CSS.
   ========================================================= */
:root{
  --bg:#0A0812; --bg2:#0F0B19; --surface:#15101F; --surface2:#1B1529;
  --line:#2A2140; --line2:#3A2E5A;
  --ink:#F4F0FF; --ink2:#D9D2EE; --muted:#A89DC6; --muted2:#7C7198;
  --violet:#7C5CFF; --violet2:#4A2FC2; --violet3:#B9A6FF; --glow:rgba(124,92,255,.35);
  --ok:#5EE0A0; --warn:#FFB86B; --bad:#FF6B8B;
  --r-s:8px; --r-m:14px; --r-l:22px;
  --font-d:"Bricolage Grotesque", system-ui, sans-serif;
  --font-b:"Instrument Sans", system-ui, sans-serif;
  --max:1240px; --gutter:clamp(20px,4vw,56px);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:90px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto} *{animation-duration:.001s!important;transition-duration:.001s!important}}
body{background:var(--bg);color:var(--ink);font-family:var(--font-b);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,textarea,select{font:inherit;color:inherit}
::selection{background:var(--violet);color:#fff}
h1,h2,h3,.display{font-family:var(--font-d);font-weight:600;letter-spacing:-.02em;line-height:1.05}
h1{font-size:clamp(40px,6.2vw,84px);font-weight:700;letter-spacing:-.035em}
h2{font-size:clamp(28px,3.6vw,46px)}
h3{font-size:clamp(18px,1.6vw,22px);font-weight:600}
p{color:var(--ink2);max-width:62ch}
.muted{color:var(--muted)}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gutter)}
section{padding:clamp(72px,9vw,128px) 0}
.grid{display:grid;gap:24px}

/* focus */
:focus-visible{outline:2px solid var(--violet3);outline-offset:3px;border-radius:6px}

/* nav */
.nav{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:rgba(10,8,18,.72);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{font-family:var(--font-d);font-weight:700;font-size:22px;letter-spacing:-.03em;display:flex;align-items:center;gap:10px}
.brand i{width:10px;height:10px;border-radius:50%;background:var(--violet);box-shadow:0 0 18px var(--glow)}
.navlinks{display:flex;gap:28px;font-size:15px;color:var(--muted)}
.navlinks a:hover{color:var(--ink)}
.navright{display:flex;align-items:center;gap:12px}
.cur{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:13px;color:var(--ink2);appearance:none;-webkit-appearance:none;padding-right:26px;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 14px) 12px,calc(100% - 10px) 12px;background-size:4px 4px;background-repeat:no-repeat}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:999px;font-weight:600;font-size:15px;transition:transform .15s ease,background .15s ease,box-shadow .15s ease;white-space:nowrap}
.btn:active{transform:scale(.98)}
.btn-p{background:var(--violet);color:#fff;box-shadow:0 8px 28px -10px var(--glow)}
.btn-p:hover{background:#8C70FF;box-shadow:0 12px 34px -10px var(--glow)}
.btn-g{background:var(--surface);border:1px solid var(--line2);color:var(--ink)}
.btn-g:hover{border-color:var(--violet3)}
.btn-s{padding:8px 14px;font-size:14px}
.cartbtn{position:relative}
.cartbtn b{position:absolute;top:-6px;right:-6px;background:var(--violet);color:#fff;font-size:11px;min-width:18px;height:18px;border-radius:9px;display:grid;place-items:center;padding:0 5px;opacity:0;transform:scale(.6);transition:all .2s}
.cartbtn b.on{opacity:1;transform:scale(1)}
@media(max-width:820px){.navlinks{display:none}}

/* hero: the fork */
.hero{padding:clamp(56px,7vw,96px) 0 clamp(40px,5vw,64px)}
.hero h1{max-width:14ch;margin-bottom:18px;opacity:0;transform:translateY(14px);animation:rise .7s .05s ease forwards}
.hero p.lead{font-size:clamp(17px,1.35vw,20px);max-width:52ch;opacity:0;transform:translateY(14px);animation:rise .7s .18s ease forwards}
@keyframes rise{to{opacity:1;transform:none}}
.fork{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:44px;opacity:0;transform:translateY(16px);animation:rise .8s .32s ease forwards}
@media(max-width:860px){.fork{grid-template-columns:1fr}}
.gate{position:relative;border:1px solid var(--line);background:linear-gradient(180deg,var(--surface),var(--bg2));border-radius:var(--r-l);padding:28px;min-height:360px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;transition:border-color .2s,transform .25s ease}
.gate:hover{border-color:var(--violet3);transform:translateY(-3px)}
.gate:focus-within{border-color:var(--violet3)}
.gate h3{font-size:clamp(24px,2.4vw,32px);font-weight:600;letter-spacing:-.025em;max-width:12ch}
.gate p{font-size:15px;color:var(--muted);max-width:34ch;margin-top:10px}
.gate .go{margin-top:22px;display:inline-flex;align-items:center;gap:10px;font-weight:600;color:var(--ink)}
.gate .go span{width:34px;height:34px;border-radius:50%;background:var(--violet);display:grid;place-items:center;transition:transform .2s}
.gate:hover .go span{transform:translateX(4px)}
.gate .tiles{position:absolute;right:-8px;top:-8px;bottom:-8px;width:46%;display:flex;gap:10px;align-items:center;justify-content:flex-end;pointer-events:none;mask-image:linear-gradient(90deg,transparent,#000 30%)}
.gate .tiles .tile{width:112px;aspect-ratio:9/16;border-radius:12px}
.gate .tiles .tile:nth-child(1){transform:translateY(38px) rotate(-4deg)}
.gate .tiles .tile:nth-child(2){transform:translateY(-22px) rotate(3deg)}
.gate .tiles .tile:nth-child(3){transform:translateY(26px) rotate(-2deg)}
@media(max-width:560px){.gate .tiles{display:none}}

/* live style tiles (CSS previews standing in for video loops) */
.tile{position:relative;overflow:hidden;background:#100C1A;border:1px solid var(--line);display:grid;place-items:center;isolation:isolate}
.tile .cap{font-family:var(--font-d);font-weight:700;color:#fff;text-align:center;line-height:1;letter-spacing:-.02em;padding:0 10%;z-index:2}
.tile .cap b{display:inline-block}
.tile .subject{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:62%;height:58%;border-radius:50% 50% 0 0/40% 40% 0 0;background:radial-gradient(ellipse at 50% 20%,#4c3b7a,#221a38 70%);opacity:.9}
.tile .head{position:absolute;bottom:42%;left:50%;transform:translateX(-50%);width:32%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 40% 35%,#6b58a8,#2c2350 70%)}
.tile.bg-bloom{background:linear-gradient(160deg,#2a1841,#0f0b1a)}
.tile.bg-slate{background:linear-gradient(160deg,#1c1830,#0b0912)}
.tile.bg-ink{background:#0c0a14}
.tile.bg-warm{background:linear-gradient(160deg,#2a1d2f,#120c17)}
.tile.bg-grid{background:#0d0a16;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:22px 22px}
.tile.bg-motion{background:linear-gradient(135deg,#2b1f5c,#0e0b18 60%)}
.tile .shape{position:absolute;border-radius:14px;background:var(--violet);opacity:.85}
/* caption animation families */
.cap.word b{opacity:.4;animation:hl 1.8s infinite}
.cap.word b:nth-child(2){animation-delay:.6s}.cap.word b:nth-child(3){animation-delay:1.2s}
@keyframes hl{0%,20%{opacity:.4;color:#fff}30%,50%{opacity:1;color:var(--violet3)}60%,100%{opacity:.4;color:#fff}}
.cap.box b{background:var(--violet);padding:.1em .3em;border-radius:6px;animation:pop 1.6s infinite}
@keyframes pop{0%,15%{transform:scale(1)}25%{transform:scale(1.08)}35%,100%{transform:scale(1)}}
.cap.behind{z-index:0;font-size:1.6em;opacity:.9}
.cap.line{border-bottom:3px solid var(--violet3);padding-bottom:.08em}
.cap.karaoke b{background:linear-gradient(90deg,var(--violet3) 50%,#fff 50%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:kar 2.2s linear infinite}
@keyframes kar{to{background-position:-100% 0}}
.cap.glow{text-shadow:0 0 14px var(--violet),0 0 30px var(--violet2)}
.cap.serif{font-family:Georgia,serif;font-weight:400;font-style:italic;letter-spacing:0}
.tile .orbit{position:absolute;inset:18% 22%;border:2px solid var(--violet3);border-radius:50%;opacity:.5;animation:spin 8s linear infinite}
.tile .orbit::after{content:"";position:absolute;top:-6px;left:50%;width:10px;height:10px;border-radius:50%;background:var(--violet3)}
@keyframes spin{to{transform:rotate(360deg)}}
.tile .bars{position:absolute;bottom:18%;left:14%;right:14%;display:flex;gap:6px;align-items:flex-end;height:30%}
.tile .bars i{flex:1;background:var(--violet);border-radius:3px 3px 0 0;animation:bar 2.4s ease-in-out infinite}
.tile .bars i:nth-child(2){animation-delay:.3s}.tile .bars i:nth-child(3){animation-delay:.6s}.tile .bars i:nth-child(4){animation-delay:.9s}
@keyframes bar{0%,100%{height:30%}50%{height:100%}}
.tile .scan{position:absolute;inset:0;background:linear-gradient(180deg,transparent 0,rgba(124,92,255,.18) 50%,transparent 100%);animation:scan 3s linear infinite;mix-blend-mode:screen}
@keyframes scan{from{transform:translateY(-100%)}to{transform:translateY(100%)}}
/* real video previews */
.tile.hasvid{background:#000}
.tile.hasvid video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.tile .cap.onvid{position:absolute;left:0;right:0;bottom:12px;z-index:2;font-size:16px;text-shadow:0 2px 10px rgba(0,0,0,.6)}
.tile.hasvid::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.5));pointer-events:none}

/* catalog */
.catalog{padding-top:24px}
.famhead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}
.famhead h2{font-size:clamp(24px,2.6vw,34px)}
.famhead p{margin-top:6px;font-size:15px;color:var(--muted)}
.famnav{display:flex;gap:8px}
.famnav button{width:40px;height:40px;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center;color:var(--ink2);transition:border-color .15s,background .15s}
.famnav button:hover{border-color:var(--violet3);background:var(--surface)}
.rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 4px 18px;scrollbar-width:none;margin:0 -4px}
.rail::-webkit-scrollbar{display:none}
.family{margin-bottom:48px}
.card{scroll-snap-align:start;flex:0 0 232px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-l);overflow:hidden;transition:border-color .2s,transform .25s ease,box-shadow .25s ease;text-align:left;display:flex;flex-direction:column}
.card:hover{border-color:var(--violet3);transform:translateY(-4px);box-shadow:0 24px 50px -30px var(--glow)}
.card .tile{aspect-ratio:9/13;border:0;border-radius:0}
.card .tile .cap{font-size:20px}
.card .meta{padding:14px 16px 16px}
.card .name{font-family:var(--font-d);font-weight:600;font-size:18px;letter-spacing:-.02em}
.card .mood{font-size:13.5px;color:var(--muted);margin-top:2px;min-height:20px}
.card .row{display:flex;justify-content:space-between;align-items:baseline;margin-top:12px}
.card .price{font-weight:600;font-size:16px}
.card .price small{font-weight:400;color:var(--muted);font-size:12.5px;margin-left:4px}
.card .tat{font-size:12.5px;color:var(--muted)}
.card .tag{position:absolute;top:10px;left:10px;font-size:11.5px;font-weight:600;background:rgba(10,8,18,.7);backdrop-filter:blur(6px);padding:4px 8px;border-radius:999px;border:1px solid var(--line2);z-index:3}
.card .tag.hot{border-color:var(--violet);color:var(--violet3)}

/* how it works */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:s}
@media(max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.steps{grid-template-columns:1fr}}
.step{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-m);padding:22px;counter-increment:s;position:relative}
.step::before{content:counter(s);position:absolute;top:18px;right:18px;font-family:var(--font-d);font-weight:700;font-size:15px;color:var(--violet3);width:28px;height:28px;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center}
.step h3{margin-bottom:8px;max-width:11ch}
.step p{font-size:14.5px;color:var(--muted);max-width:30ch}

/* two-column feature */
.split{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center}
@media(max-width:900px){.split{grid-template-columns:1fr;gap:32px}}
.split h2{margin-bottom:14px}
.split ul{list-style:none;margin-top:22px;display:grid;gap:12px}
.split li{display:flex;gap:12px;color:var(--ink2);font-size:15.5px}
.split li::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--violet);margin-top:8px;flex:none;box-shadow:0 0 10px var(--glow)}
.demo{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-l);padding:22px}
.field{display:flex;flex-direction:column;gap:8px}
.field label{font-size:13.5px;color:var(--muted)}
.field input,.field textarea,.field select{background:var(--bg2);border:1px solid var(--line2);border-radius:10px;padding:13px 14px;color:var(--ink);width:100%;transition:border-color .15s,box-shadow .15s}
.field input:focus,.field textarea:focus,.field select:focus{outline:0;border-color:var(--violet);box-shadow:0 0 0 3px rgba(124,92,255,.2)}
.verify{margin-top:12px;font-size:14px;display:flex;gap:10px;align-items:flex-start;min-height:22px}
.verify .dot{width:10px;height:10px;border-radius:50%;margin-top:6px;flex:none;background:var(--muted2)}
.verify.ok .dot{background:var(--ok);box-shadow:0 0 10px var(--ok)}
.verify.bad .dot{background:var(--bad)}
.verify.wait .dot{background:var(--warn);animation:blink 1s infinite}
@keyframes blink{50%{opacity:.3}}
.verify code{background:var(--bg);border:1px solid var(--line);padding:1px 6px;border-radius:5px;font-size:12.5px}
.fileinfo{margin-top:12px;display:none;gap:10px;font-size:13.5px;color:var(--muted)}
.fileinfo.on{display:flex}
.fileinfo span{background:var(--bg2);border:1px solid var(--line);padding:5px 10px;border-radius:999px}

/* compare */
.compare{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:760px){.compare{grid-template-columns:1fr}}
.col{border:1px solid var(--line);border-radius:var(--r-l);padding:26px;background:var(--surface)}
.col.us{border-color:var(--violet2);background:linear-gradient(180deg,rgba(124,92,255,.08),var(--surface) 40%)}
.col h3{margin-bottom:16px}
.col ul{list-style:none;display:grid;gap:10px}
.col li{font-size:15px;color:var(--ink2);padding-left:22px;position:relative}
.col li::before{content:"";position:absolute;left:0;top:9px;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--muted2)}
.col.us li::before{border:0;background:var(--violet);box-shadow:0 0 10px var(--glow)}

/* packs / pricing */
.packs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
@media(max-width:900px){.packs{grid-template-columns:1fr}}
.pack{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-l);padding:26px;display:flex;flex-direction:column;position:relative}
.pack.best{border-color:var(--violet);box-shadow:0 30px 60px -40px var(--glow)}
.pack .ribbon{position:absolute;top:-12px;left:22px;font-size:12px;font-weight:600;background:var(--violet);color:#fff;padding:4px 10px;border-radius:999px}
.pack h3{font-size:22px}
.pack .for{font-size:14px;color:var(--muted);margin-top:4px}
.pack .amt{font-family:var(--font-d);font-size:44px;font-weight:700;letter-spacing:-.03em;margin:18px 0 2px}
.pack .amt small{font-size:15px;font-weight:500;color:var(--muted);letter-spacing:0;margin-left:6px;font-family:var(--font-b)}
.pack .per{font-size:13.5px;color:var(--muted)}
.pack ul{list-style:none;margin:20px 0 24px;display:grid;gap:9px;flex:1}
.pack li{font-size:14.5px;color:var(--ink2);padding-left:20px;position:relative}
.pack li::before{content:"";position:absolute;left:0;top:9px;width:7px;height:7px;border-radius:50%;background:var(--violet3)}
.slots{font-size:13px;color:var(--warn);margin-top:10px}

/* faq */
.faq{max-width:760px}
.q{border-top:1px solid var(--line);padding:18px 0}
.q:last-child{border-bottom:1px solid var(--line)}
.q button{width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;text-align:left;font-weight:600;font-size:17px;padding:4px 0}
.q button i{width:22px;height:22px;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center;transition:transform .2s;flex:none}
.q[open] button i{transform:rotate(45deg);border-color:var(--violet3)}
.q .a{display:none;padding-top:10px;color:var(--muted);font-size:15px;max-width:60ch}
.q[open] .a{display:block}

/* footer */
footer{border-top:1px solid var(--line);padding:40px 0;color:var(--muted);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}

/* drawer (order flow) */
.scrim{position:fixed;inset:0;background:rgba(6,4,12,.6);backdrop-filter:blur(4px);opacity:0;pointer-events:none;transition:opacity .25s;z-index:80}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--bg2);border-left:1px solid var(--line);z-index:90;transform:translateX(100%);transition:transform .32s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column}
.drawer.on{transform:none}
.dhead{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--line)}
.dhead .t{font-family:var(--font-d);font-weight:600;font-size:20px;letter-spacing:-.02em}
.dhead button{width:36px;height:36px;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center}
.dbody{padding:22px;overflow-y:auto;flex:1;display:grid;gap:18px;align-content:start}
.dfoot{padding:16px 22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:14px;background:var(--bg2)}
.dfoot .tot{font-family:var(--font-d);font-size:24px;font-weight:700;letter-spacing:-.02em}
.dfoot .tot small{font-family:var(--font-b);font-size:13px;color:var(--muted);font-weight:400;display:block}
.progress{display:flex;gap:6px}
.progress i{height:3px;flex:1;background:var(--line2);border-radius:2px}
.progress i.on{background:var(--violet)}
.pick{display:flex;gap:14px;align-items:center}
.pick .tile{width:64px;aspect-ratio:9/13;border-radius:10px}
.pick .tile .cap{font-size:8px}
.pick .n{font-family:var(--font-d);font-weight:600;font-size:18px;letter-spacing:-.02em}
.pick .m{font-size:13px;color:var(--muted)}
.qty{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.qty button{border:1px solid var(--line2);border-radius:12px;padding:12px 8px;text-align:center;background:var(--surface);transition:border-color .15s,background .15s}
.qty button b{display:block;font-family:var(--font-d);font-size:20px;font-weight:700;letter-spacing:-.02em}
.qty button small{display:block;font-size:12px;color:var(--muted);margin-top:2px}
.qty button.on{border-color:var(--violet);background:rgba(124,92,255,.12)}
.opt{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--surface);font-size:14.5px}
.opt small{display:block;color:var(--muted);font-size:12.5px}
.opt input[type=checkbox]{width:18px;height:18px;accent-color:var(--violet)}
.line{display:flex;justify-content:space-between;font-size:14.5px;color:var(--ink2);padding:6px 0;border-bottom:1px dashed var(--line)}
.line.total{border:0;font-weight:600;color:var(--ink);font-size:16px;padding-top:12px}
.note{font-size:13px;color:var(--muted);line-height:1.5}
