# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:8080

# Database Configuration (MongoDB)
# Example local: mongodb://localhost:27017/heypitch
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/heypitch?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Configuration (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Security and Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# External Integrations (PENDING Client Provider Choice)
# Options: 'unconfigured' (default) | 'stripe'
PAYMENT_PROVIDER=unconfigured
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
